# Copy to .env and fill in. Never commit .env (ADR-0010).

# OpenAI-compatible endpoint. Default is Gemini's (ADR-0002).
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
# Exact, versioned model ID — never a -latest alias.
LLM_MODEL=
EMBED_MODEL=

# Hugging Face read token for downloading MIND (accept the terms at
# https://huggingface.co/datasets/yjw1029/MIND first). See scripts/download_mind.py.
HF_TOKEN=

# Max concurrent LLM calls.
CONCURRENCY=8

# true = fake, clearly labelled outputs; no key needed.
MOCK_LLM=true

# Follow-up experiment only: tell the model the base click rate (ADR-0005).
BASE_RATE_HINT=false

# Hosted read-only mode: no new runs, rate-limited interview (ADR-0011).
DEMO_MODE=false
