# Force LF line endings on every text file the repo tracks. Kills the CRLF
# warnings Windows contributors otherwise hit on every `git status`.
* text=auto eol=lf

# Explicit binary types — never normalise these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.tar binary
*.woff binary
*.woff2 binary
*.mp3 binary
*.mp4 binary
*.wav binary
*.flac binary
*.ogg binary
*.webm binary
*.sqlite binary
*.db binary
